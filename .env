# Database
DATABASE_URL=mysql+asyncmy://ramzan_user:changeme@localhost:3306/ramzan_mart
DATABASE_URL_SYNC=mysql+pymysql://ramzan_user:changeme@localhost:3306/ramzan_mart
# Security
SECRET_KEY=<run: python -c "import secrets; print(secrets.token_urlsafe(48))
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
